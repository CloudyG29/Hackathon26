# Copy to .env and fill in. Never commit .env.

# Port the Express server listens on
PORT=4000

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side only. Bypasses row-level security - never ship this to the app.
# (Legacy name SUPABASE_SERVICE_ROLE_KEY still works as a fallback.)
SUPABASE_SECRET_KEY=sb_secret_...
# JSON Web Key Set, for verifying user JWTs if we add auth (optional for now)
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
