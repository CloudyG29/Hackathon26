# Copy to .env. Values prefixed EXPO_PUBLIC_ are embedded in the JS bundle.

# Base URL of the local API (services/api)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google Maps SDK for Android. Restrict this key in Google Cloud Console by
# Android package name (com.hackathon26.transitguide) + SHA-1 fingerprint.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
